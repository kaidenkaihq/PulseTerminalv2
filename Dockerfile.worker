FROM node:24-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY worker ./worker
COPY lib ./lib
RUN npm run build:worker && npm prune --omit=dev --ignore-scripts
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production WORKER_HOST=0.0.0.0 WORKER_PORT=4000 LOCAL_DATA_DIR=/data
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist-worker ./dist-worker
COPY package.json ./
RUN mkdir /data && chown node:node /data
USER node
VOLUME ["/data"]
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:'+process.env.WORKER_PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist-worker/index.mjs"]
