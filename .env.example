# live never silently switches to generated data. Select replay explicitly.
DATA_MODE=live
WORKER_HOST=127.0.0.1
WORKER_PORT=4100
FRONTEND_ORIGINS=http://localhost:3100
NEXT_PUBLIC_WORKER_URL=http://localhost:4100
# Required for non-loopback paper-trading mutations. Enter in Settings (session only).
WORKER_API_TOKEN=
# Optional; worker only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_DATA_DIR=./data
WATCHLIST=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,ADA-USD,AVAX-USD,LINK-USD,LTC-USD,DOT-USD
FRESHNESS_MS=5000
DIVERGENCE_PERCENT=0.20
ATR_PERIOD=14
SUPER_TREND_MULTIPLIER=3
PAPER_BALANCE=10000
# Kalshi BTC 15m contracts (read-only market data; no order endpoint exists in this app).
# Worker only. Never prefix these with NEXT_PUBLIC_. Without a key the worker polls Kalshi's
# public REST market data once per second; a key adds the authenticated WebSocket ticker.
KALSHI_ENABLED=true
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_SERIES=KXBTC15M
KALSHI_FRESHNESS_MS=5000
# Kalshi quadratic fee: ceil(rate × C × P × (1−P)) to the account's balance precision.
KALSHI_FEE_RATE=0.07
KALSHI_FEE_PRECISION=0.01
# Seconds-to-close bucket edges: 15–10m, 10–5m, 5–2m, 2–0m.
CONTRACT_BUCKETS=900,600,300,120,0
CONTRACT_TICK_RETENTION_DAYS=30
# Panic-Fade (fade-v1) defaults. Recorded with every contract snapshot.
FADE_SIGMA=2.5
FADE_WINDOW_S=30
FADE_EXHAUSTION=0.25
FADE_TTC_MIN=30
FADE_TTC_MAX=600
FADE_LOOKBACK_MIN=15
# Calibration: an engine × bucket drives verdicts only after this many out-of-sample windows.
CALIBRATION_MIN_N=200
CALIBRATION_REFIT_EVERY=4
CALIBRATION_RECENT_N=100
# Verdict: calibrated edge after fees required to suggest a contract.
MIN_EDGE=0.03
# Simulated contract paper account (never places real orders).
CONTRACT_BALANCE=1000
CONTRACT_SIZE=10
CONTRACT_MAX_STAKE=50
CONTRACT_MAX_DAILY_LOSS=100
# Exits: take profit at a 97¢ bid is always on (owner rule).
# Owner to supply: stop-loss phases "secondsToClose:stopBid,..." (e.g. 120:0.10) and
# ratchet levels "peakTrigger:floorBid,..." (e.g. 0.80:0.65). Empty = not applied.
CONTRACT_EXIT_PHASES=
CONTRACT_RATCHET=
