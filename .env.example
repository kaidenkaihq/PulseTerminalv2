# live never silently switches to generated data. Select replay explicitly.
DATA_MODE=live
WORKER_HOST=127.0.0.1
WORKER_PORT=4000
FRONTEND_ORIGINS=http://localhost:3000
NEXT_PUBLIC_WORKER_URL=http://localhost:4000
# Required for non-loopback paper-trading mutations. Enter in Settings (session only).
WORKER_API_TOKEN=
# Optional; worker only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_DATA_DIR=./data
WATCHLIST=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,ADA-USD,AVAX-USD,LINK-USD,LTC-USD,DOT-USD
FRESHNESS_MS=5000
DIVERGENCE_PERCENT=0.20
ATR_PERIOD=14
SUPER_TREND_MULTIPLIER=3
PAPER_BALANCE=10000
